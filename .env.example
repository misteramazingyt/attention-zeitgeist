# Attention Ledger configuration
# Copy this file to .env and adjust as needed. All values are optional;
# sensible defaults are applied in src/attention_ledger/config.py.

# Root directory for the project data tree (defaults to ./data)
ATTENTION_LEDGER_DATA_DIR=./data

# Path to the DuckDB database file
ATTENTION_LEDGER_DB_PATH=./data/processed/attention_ledger.duckdb

# Default Wikimedia project for pageview ingestion
ATTENTION_LEDGER_WIKI_PROJECT=en.wikipedia

# GDELT API base (DOC 2.0 API). Override only if mirroring.
ATTENTION_LEDGER_GDELT_API=https://api.gdeltproject.org/api/v2/doc/doc

# Wikimedia REST API base
ATTENTION_LEDGER_WIKI_API=https://wikimedia.org/api/rest_v1

# Network timeout (seconds) and retry attempts for HTTP connectors
ATTENTION_LEDGER_HTTP_TIMEOUT=60
ATTENTION_LEDGER_HTTP_RETRIES=3

# Logging level: DEBUG, INFO, WARNING, ERROR
ATTENTION_LEDGER_LOG_LEVEL=INFO

# Offline / demo mode: when true, connectors that support it generate
# deterministic synthetic data instead of hitting the network. Useful for
# `make demo` in sandboxed environments without outbound access.
ATTENTION_LEDGER_OFFLINE=false
